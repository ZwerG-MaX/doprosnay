# Альтернативный Dockerfile для mumble-web-proxy
# Загружает готовый бинарник из GitHub releases для быстрого развёртывания
# Runtime образ: Alpine (лёгкий, ~50-80 MB)

FROM alpine:3.19

# Runtime зависимости (только библиотеки, без dev-пакетов)
RUN apk add --no-cache \
    wget \
    ca-certificates \
    libnice \
    glib \
    openssl \
    opus \
    libogg

WORKDIR /app

# Скачиваем готовый бинарник из GitHub releases
# Версия 0.5.0 - последняя стабильная на момент создания
RUN wget -q https://github.com/Johni0702/mumble-web-proxy/releases/download/v0.5.0/mumble-web-proxy \
    -O /usr/local/bin/mumble-web-proxy \
    && chmod +x /usr/local/bin/mumble-web-proxy

# 1337 — WebSocket (через nginx/Traefik на mumble-web)
# 64737 — UDP для WebRTC-медиа (пробрасывается напрямую)
EXPOSE 1337/tcp 64737/udp

CMD ["mumble-web-proxy"]
