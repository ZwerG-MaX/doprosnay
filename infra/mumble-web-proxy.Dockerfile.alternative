# Альтернативный Dockerfile для mumble-web-proxy
# Загружает готовый бинарник из форка для быстрого развёртывания
# Runtime образ: Debian slim (совместимость с glibc)

FROM debian:bookworm-slim

# Runtime зависимости (только библиотеки, без dev-пакетов)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    libnice10 \
    libglib2.0-0 \
    libssl3 \
    libopus0 \
    libogg0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Скачиваем готовый бинарник из форка
RUN wget -q https://github.com/ZwerG-MaX/mumble-web-proxy-rust-1.89/releases/download/untagged-d7079c08d2d466eb476d/mumble-web-proxy \
    -O /usr/local/bin/mumble-web-proxy \
    && chmod +x /usr/local/bin/mumble-web-proxy

# 64737 — WebSocket для mumble-web
# 20000-21000 — UDP порты для WebRTC ICE
EXPOSE 64737/tcp 20000-21000/udp

# Запуск с обязательными параметрами
CMD ["mumble-web-proxy", "--listen-ws", "64737", "--server", "rt-mumble:64738", "--ice-port-min", "20000", "--ice-port-max", "21000"]
