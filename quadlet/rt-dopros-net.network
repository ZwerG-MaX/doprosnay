# Quadlet-конфигурация для Podman
# Установка: скопируйте файлы в ~/.config/containers/systemd/
# Запуск: systemctl --user daemon-reload && systemctl --user start rt-dopros.target

# ── Сеть ──────────────────────────────────────────────────────────
[Network]
NetworkName=rt-dopros-net
Subnet=10.89.0.0/24
Gateway=10.89.0.1
