[Unit]
Description=mumble-web-proxy — мост Mumble ⇄ WebSocket/WebRTC
After=rt-mumble.service rt-dopros-net.network
Requires=rt-mumble.service rt-dopros-net.network

[Container]
Image=quay.io/podman/stable:latest
ContainerName=rt-mumble-proxy
# В Quadlet нельзя собрать образ на лету — нужно предварительно:
#   podman build -t rt-mumble-web-proxy -f infra/mumble-web-proxy.Dockerfile
# Затем заменить Image на rt-mumble-web-proxy
Image=rt-mumble-web-proxy:latest
Network=rt-dopros-net.network
# 64737/tcp — WebSocket для mumble-web
# 20000-21000/udp — порты для WebRTC ICE
PublishPort=64737:64737/tcp
PublishPort=20000-21000:20000-21000/udp

[Install]
WantedBy=default.target
